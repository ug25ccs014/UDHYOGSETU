# UDYOGSETU deployment environment configuration (repository root).
#
# This file is the reference for Docker Compose (local/demo) and documents the
# variables used by Railway (backend service) and Vercel (frontend build).
# Copy to `.env` locally for `docker compose up`. NEVER commit a real `.env`.
# Generate your JWT secret with: python -c "import secrets; print(secrets.token_hex(32))"

# Application
DEBUG=false
ENVIRONMENT=production
APP_NAME=UDYOGSETU
APP_VERSION=1.0.0

# Database (Docker Compose uses the `postgres` service; Railway PostgreSQL
# injects DATABASE_URL automatically). A plain postgresql:// URL works too —
# the async engine assumes the asyncpg driver for PostgreSQL URLs.
DATABASE_URL=postgresql+asyncpg://udyogsetu:password@postgres:5432/udyogsetu

# Redis (Docker Compose uses the `redis` service; Railway Redis injects
# REDIS_URL automatically). Used by the rate limiter; fails open if unreachable.
REDIS_URL=redis://redis:6379/0

# Security (PRODUCTION: required — the app fails fast without it)
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# CORS origins and trusted Hosts — JSON arrays.
# LOCAL:      CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://127.0.0.1:3000"]
#             ALLOWED_HOSTS=["localhost","127.0.0.1"]
# RAILWAY/Vercel production:
#             CORS_ORIGINS=["https://<your-vercel-domain>.vercel.app"]
#             ALLOWED_HOSTS=["localhost","127.0.0.1","<your-service>.<env>.up.railway.app"]
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://127.0.0.1:3000"]
ALLOWED_HOSTS=["localhost","127.0.0.1"]

# Rate limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_ENABLED=true

# AI Providers (optional; default falls back to a safe mock provider)
GEMINI_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_LLM_PROVIDER=gemini

# Embeddings (mock is the default; no external service required)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_PROVIDER=mock

# File Storage (Docker Compose mounts /var/uploads as a volume; Railway file
# storage is ephemeral — see DEPLOYMENT.md limitations)
UPLOAD_DIRECTORY=/var/uploads
MAX_UPLOAD_SIZE_MB=50

# Email/SMTP (optional)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Frontend (Vercel build-time variable — set per-environment, NOT in .env here)
# NEXT_PUBLIC_API_URL=https://<railway-backend-url>/api
# Government integration provider: prototype until authorized adapters are configured.
GOVERNMENT_INTEGRATION_PROVIDER=prototype

# Prototype government adapters use a deterministic SIH story by default.
GOVERNMENT_PROTOTYPE_SCENARIO=si_demo
