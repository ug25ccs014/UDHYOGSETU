# UDYOGSETU - single-VM production variables (copy this file to .env in this
# directory and fill in real values; NEVER commit the .env).

# PostgreSQL superuser password for the local database (required).
POSTGRES_PASSWORD=change-me

# JWT signing secret (required). Generate:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-64-hex-chars

# Production mode (do not change for a live deployment).
ENVIRONMENT=production
DEBUG=false

# Allowed browser origin(s) - JSON array. Must be the exact Vercel URL.
#   CORS_ORIGINS=["https://<your-app>.vercel.app"]
CORS_ORIGINS=["https://example.vercel.app"]

# Trusted Host header values - JSON array. MUST include the VM public IP or the
# instance hostname (and the public DNS if you use one), otherwise every
# request is rejected with HTTP 400.
#   ALLOWED_HOSTS=["localhost","127.0.0.1","<PUBLIC_IP>","<instance>.oraclecloud.com"]
ALLOWED_HOSTS=["localhost","127.0.0.1"]

# Optional server-side AI keys (keep blank to use the safe mock provider).
GEMINI_API_KEY=
GROQ_API_KEY=

# Rate limiting (optional tuning).
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_ENABLED=true