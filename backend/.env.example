# UDYOGSETU backend local/development environment.
#
# This file documents the variables used when running the backend directly from
# the `backend/` directory (uvicorn / alembic / pytest). Copy it to `.env` in
# this directory for local development. NEVER commit a real `.env`.
#
# For Docker Compose use the repository-root `.env` (see docker-compose.yml).
# For Railway use the service variables panel — Railway PostgreSQL/Redis set
# DATABASE_URL / REDIS_URL automatically when attached.

# Application ---------------------------------------------------------------
# Set DEBUG=false and ENVIRONMENT=production in production. In production the
# app fails fast at startup if JWT_SECRET_KEY is missing/empty.
DEBUG=false
ENVIRONMENT=development

# Database ------------------------------------------------------------------
# Local PostgreSQL (adjust user/password/host/port). Docker Compose replaces
# this with the `postgres` service; Railway injects DATABASE_URL automatically.
# A plain `postgresql://` URL works too — SQLAlchemy's async engine assumes
# the asyncpg driver for PostgreSQL URLs.
DATABASE_URL=postgresql+asyncpg://udyogsetu:password@localhost:5432/udyogsetu

# Redis ----------------------------------------------------------------------
# Docker Compose replaces this with the `redis` service; Railway injects
# REDIS_URL automatically when a Redis service is attached. Redis is used by
# the rate limiter only, and the app fails open if Redis is unreachable.
REDIS_URL=redis://localhost:6379/0

# Security -------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# REQUIRED in production (startup refuses to run without it).
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# CORS / Hosts ---------------------------------------------------------------
# JSON arrays (pydantic-settings list parsing). Production must list the exact
# frontend origin(s) and host(s), e.g.:
#   CORS_ORIGINS=["https://udyogsetu.vercel.app"]
#   ALLOWED_HOSTS=["localhost","127.0.0.1","udyogsetu-production.up.railway.app"]
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://127.0.0.1:3000"]
ALLOWED_HOSTS=["localhost","127.0.0.1"]

# Rate limiting --------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_ENABLED=true

# AI Providers (optional; falls back to safe mock provider) ------------------
GEMINI_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_LLM_PROVIDER=gemini

# Embeddings (mock is the default; no external service required) -------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_PROVIDER=mock

# File Storage ----------------------------------------------------------------
# Local filesystem (ephemeral on Railway — see deployment docs, limitation).
# Docker Compose mounts a volume here (/var/uploads).
UPLOAD_DIRECTORY=/tmp/udyogsetu/uploads
MAX_UPLOAD_SIZE_MB=50

# Email/SMTP (optional) ------------------------------------------------------
SMTP_SERVER=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Government integration provider: prototype until authorized adapters are configured.
GOVERNMENT_INTEGRATION_PROVIDER=prototype
# Deterministic SIH walkthrough. Set to "deterministic" for stable non-demo hashing.
GOVERNMENT_PROTOTYPE_SCENARIO=si_demo
