# UDYOGSETU frontend environment configuration (Next.js).
#
# NEXT_PUBLIC_* values are inlined at BUILD time and sent to the browser.
# NEVER put backend secrets (JWT_SECRET_KEY, DATABASE_URL, API keys) here.
#
#   Local development:  NEXT_PUBLIC_API_URL=http://localhost:8000/api
#   Vercel Production:  NEXT_PUBLIC_API_URL=https://<railway-backend-url>/api
#   Vercel Preview:     NEXT_PUBLIC_API_URL=https://<railway-preview-url>/api
#
# Backend routes are served under /api, so the value must end in /api.

NEXT_PUBLIC_API_URL=http://localhost:8000/api